# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境（部署时用 setup.cmd / setup.sh 自动重建）
#
# ★ 本项目的 venv 由 bot 统一管理，位置在 <bot>/tools/.venv，
#   通过环境变量 CARDFORGE_VENV 或 settings.json 的 "venv" 字段指过来，
#   不在这里再建一份（rembg + onnxruntime 体积大，重复装没意义）。
#   独立使用 cardforge 时才会回退到本目录的 .venv。
.venv/
venv/
env/

# 模型（约 2GB，rembg 首次使用时自动下载到 models/）
models/
*.onnx

# 生成产物（每张卡一个目录 + 临时缓存）
assets/output/
# 批量还原 200 张 × 9 版时，每张卡还会各生成一份「特效定义」与「共享立绘」，
# 加起来上千个文件，全部是 assets/output 的副产物 → 不入库。
# （已跟踪的少量示例文件不受影响，git 只在新增时看这些规则。）
assets/effects/*-*.json
assets/effects-images/artmask.png
assets/shared/cards/
cards/
# 共享层（边光/底板/徽章/特效贴图）由渲染自动 ensure，缺了会重建 → 新生成的不入库
assets/shared/seal/
assets/shared/deco/
assets/shared/badges/
assets/shared/fx/
cards.zip
album.html
albums.json
codex.html
demo-all-layers.png

# 素材包（大素材不入仓库，按需导入到 packs/ 下；packs.json 是本地启用/禁用状态）
packs/
packs.json

# ⚠️ 注意：assets/ 下的**素材**（backgrounds / frames / seals / backs / faces /
#    frames-text / effects / effects-images / lib）是【必须入库】的项目资产 ——
#    它们是卡牌制作的基础素材，不随 bot 仓库分发，缺了就会"素材清单为空"。
#    别给 assets/ 整体加忽略规则，只忽略 assets/output/（生成产物）即可。

# 临时/测试脚本与诊断图（_ 前缀；工具脚本豁免）
_*.py
_*.png
_*.html
webcard.py.bak
!_generate_seals.py
!_regen_cards.py

# IDE / 系统
.idea/
.vscode/
*.log
Thumbs.db
.DS_Store

# 浏览器自动化临时配置目录（browser profile）
_edge_profile/

# 本地配置（含抠图 API 的 AccessKey，绝不上传）
settings.json

# 开发计划/测试文档（仅本地，不上传 GitHub）
*.md
!README.md
